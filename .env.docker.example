ENVIRONMENT=development
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
LITELLM_BASE_URL=https://api.openai.com/v1
LITELLM_API_KEY=replace-with-your-provider-api-key
LITELLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_COST_USD_PER_REQUEST=0
LLM_MAX_OUTPUT_TOKENS=2400
LLM_RETRY_ATTEMPTS=2
UPLOAD_MAX_BYTES=10485760
RESUME_STUDIO_RATE_LIMIT_PER_MINUTE=30
AUTH_MODE=local
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/app/.careerpilot-storage
TASK_MODE=inline
ENABLE_DEV_JOB_PROVIDER=true
