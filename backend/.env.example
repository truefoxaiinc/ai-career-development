ENVIRONMENT=development

DATABASE_URL=sqlite:///./careerpilot-dev.db

# AWS RDS PostgreSQL (production alternative to DATABASE_URL)
RDS_HOST=
RDS_PORT=5432
RDS_DB_NAME=
RDS_USERNAME=
RDS_PASSWORD=
RDS_SSLMODE=require

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

JWT_SECRET=replace-with-a-secure-secret
ACCESS_TOKEN_MINUTES=60

AUTH_MODE=local

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.careerpilot-storage
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

TASK_MODE=inline

ENABLE_DEV_JOB_PROVIDER=true

# External job discovery providers. Add credentials only for providers
# you are authorized to use.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

JOOBLE_API_KEY=

USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=

REED_API_KEY=

# Employer ATS boards to monitor. Values are provider-specific board/company
# identifiers, not arbitrary URLs.
JOB_PROVIDER_TARGETS_JSON={"greenhouse":[],"lever":[],"ashby":[]}

LITELLM_BASE_URL=https://api.openai.com/v1
LITELLM_API_KEY=your-openai-api-key
LITELLM_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=45
LLM_MAX_COST_USD_PER_REQUEST=0.10
LLM_MAX_OUTPUT_TOKENS=2400
LLM_RETRY_ATTEMPTS=2
UPLOAD_MAX_BYTES=10485760
RESUME_STUDIO_RATE_LIMIT_PER_MINUTE=30

# Transactional email: set CAREERPILOT_EMAIL_PROVIDER=microsoft_graph in production.
# Requires Microsoft Graph Mail.Send APPLICATION permission with admin consent.
# Restrict app's mailbox access to the designated sender in Microsoft 365.
CAREERPILOT_EMAIL_PROVIDER=smtp
CAREERPILOT_GRAPH_TENANT_ID=
CAREERPILOT_GRAPH_CLIENT_ID=
CAREERPILOT_GRAPH_CLIENT_SECRET=
CAREERPILOT_GRAPH_SENDER=
SMTP_FROM_EMAIL=
