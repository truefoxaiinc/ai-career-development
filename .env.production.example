ENVIRONMENT=production
NEXT_PUBLIC_API_URL=https://app.truefoxaiinc.com/api/v1
NEXT_PUBLIC_API_ORIGIN=https://career.truefoxaiinc.com
FRONTEND_URL=https://career.truefoxaiinc.com
FRONTEND_PORT=13000
API_PORT=18000

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_MODE=local
COOKIE_SECURE=true


SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM_EMAIL=replace-with-your-from-address
SMTP_STARTTLS=true

RDS_HOST=replace-with-your-postgres-host
RDS_PORT=5432
RDS_DB_NAME=careerpilot
RDS_USERNAME=careerpilot
RDS_PASSWORD=replace-with-your-database-password
RDS_SSLMODE=require
REDIS_PASSWORD=replace-with-a-strong-cache-password

# Recommended for horizontally scaled production: STORAGE_BACKEND=s3 plus
# the S3_* settings below. For this single-host deployment, opt in explicitly
# and back up the backend-storage Docker volume off-host.
STORAGE_BACKEND=local
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true
LOCAL_STORAGE_DIR=/app/.careerpilot-storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=
TASK_MODE=database
ENABLE_DEV_JOB_PROVIDER=false

LITELLM_BASE_URL=https://api.openai.com/v1
LITELLM_API_KEY=replace-with-your-provider-api-key
LITELLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_COST_USD_PER_REQUEST=0.10
LLM_MAX_OUTPUT_TOKENS=2400
LLM_RETRY_ATTEMPTS=2
UPLOAD_MAX_BYTES=10485760
RESUME_STUDIO_RATE_LIMIT_PER_MINUTE=30
